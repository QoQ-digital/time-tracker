# =======================================================================
# Tetris Time Tracker — environment template
# Copy to .env and fill in real values BEFORE running docker compose up.
# Never commit .env. Generate strong secrets with: openssl rand -hex 32
# =======================================================================

# --- PostgreSQL ---
POSTGRES_DB=time_tracker
POSTGRES_USER=time_tracker_app
POSTGRES_PASSWORD=

# --- n8n core ---
# Generate both with `openssl rand -hex 32`
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=

N8N_HOST=tracker.qoq-dev.xyz
N8N_PROTOCOL=https
N8N_PORT=5678

# Subdomain-based deploy at root path. The existing nginx in front
# (/srv/nginx/) terminates TLS for tracker.qoq-dev.xyz and proxies the
# whole vhost to the n8n container.
N8N_PATH=/
WEBHOOK_URL=https://tracker.qoq-dev.xyz/
N8N_EDITOR_BASE_URL=https://tracker.qoq-dev.xyz/

GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw

# --- Telegram bot ---
# Create via @BotFather, paste token here. Keep secret.
TELEGRAM_BOT_TOKEN=

# Comma-separated allowlist. At least one of user_ids OR chat_ids must match.
# Find your user_id via @userinfobot in Telegram.
AUTHORIZED_TELEGRAM_USER_IDS=
AUTHORIZED_TELEGRAM_CHAT_IDS=

# --- AI provider (OpenAI by default) ---
# Get from https://platform.openai.com/api-keys
# To switch to Anthropic instead, set:
#   AI_API_URL=https://api.anthropic.com/v1/messages
#   AI_MODEL=claude-haiku-4-5-20251001
# and revert nodes 07/08/09 to the Anthropic shape.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_CONFIDENCE_THRESHOLD=0.80

# --- App behavior ---
MAX_ACTIVE_EXAMPLES_PER_CATEGORY=30
DASHBOARD_DEFAULT_MODE=compact
DASHBOARD_MAX_CATEGORIES=8
